{
  "name": "nav-brahmi-licensed-installer",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "check:placeholders": "tsx scripts/check-placeholders.ts",
    "build": "tsx scripts/check-placeholders.ts && next build",
    "postinstall": "prisma generate",
    "start": "next start",
    "lint": "eslint .",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:seed": "tsx prisma/seed.ts",
    "package:drivers": "tsx scripts/package-drivers.ts",
    "build:bootstrapper": "tsx scripts/build-bootstrapper.ts",
    "sync:b2": "tsx scripts/sync-b2-packages.ts",
    "upload:windows-package": "tsx scripts/upload-windows-package.ts",
    "email:process": "tsx scripts/process-email-outbox.ts",
    "orders:reconcile": "tsx scripts/reconcile-orders.ts",
    "keys:generate": "tsx scripts/generate-signing-keys.ts",
    "package:register": "tsx scripts/register-package.ts",
    "test": "DATABASE_URL=\"${DATABASE_URL:-postgresql://postgres:postgres@localhost:5432/navbrahmi_scratch}\" node --env-file=.env --conditions=react-server --import tsx --test tests/**/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.699.0",
    "@aws-sdk/s3-request-presigner": "^3.699.0",
    "@prisma/client": "^5.22.0",
    "next": "16.4.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^20.17.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.20.0",
    "eslint-config-next": "16.4.3",
    "postcss": "^8.5.31",
    "prisma": "^5.22.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  },
  "overrides": {
    "source-map-js": "^1.2.2"
  }
}
